datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  createdAt DateTime @default(now())
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  price       Float
  unit        String
  image       String
  description String?
  stock       Int     @default(0)
  status      String  @default("Active")
  tag         String?
  category    String?
  inStock     Boolean @default(true)
}

model Coupon {
  id       Int    @id @default(autoincrement())
  code     String @unique
  discount Float
  type     String
  minOrder Int    @default(0)
  maxUses  Int    @default(100)
  used     Int    @default(0)
  status   String @default("Active")
  expires  String
}

model Order {
  id       String @id // e.g. ORD-001
  customer String
  items    Json
  total    Float
  status   String @default("Pending")
  date     String
  address  String
  phone    String
  payment  String
}

model HeroVideo {
  id         Int     @id @default(autoincrement())
  slideIndex Int     @unique
  saved      String  @db.Text
  fileName   String?
}
